# Roqqu API Services key. "test" sends x-staging-api-key, "live" sends x-api-key.
ROQQU_API_KEY=
ROQQU_MODE=test

# Base Sepolia
RPC_URL=https://sepolia.base.org
CHAIN_ID=84532
FLEDGE_ADDRESS=

# Backend operator: credits Roqqu-confirmed payments and records Roqqu payouts.
OPERATOR_KEY=

# Demo mode only: server-side signers for the Oga, apprentice and witnesses,
# comma-separated in that order. Leave empty to require real wallets.
DEMO_KEYS=

PUBLIC_URL=http://localhost:8790
PORT=8790
